n.hero-editorial .body-column p + p {margin-top: 14px}\n\n/* 首屏内嵌锚点标签导航 */\n.hero-anchors {padding-top: 28px;border-top: 1px solid var(--blue-100);display: flex;flex-wrap: wrap;align-items: center;gap: 12px}\n.hero-anchors .anchor-label {font-size: 13px;font-weight: 600;color: var(--blue-700);margin-right: 6px}\n.hero-anchors a {display: inline-flex;align-items: center;padding: 8px 18px;border-radius: var(--radius-pill);background: var(--blue-50);color: var(--blue-900);font-size: 14px;font-weight: 600;transition: all 0.2s ease}\n.hero-anchors a:hover {background: var(--amber-500);color: #ffffff;transform: translateY(-1px)}\n\n/* 区块通用结构 */\n.section-block {margin-bottom: 64px}\n.section-head {margin-bottom: 32px}\n.section-head .eyebrow {display: inline-block;font-size: 12px;font-weight: 700;text-transform: uppercase;letter-spacing: 0.1em;color: var(--amber-500);margin-bottom: 8px}\n.section-head h2 {font-size: 28px;font-weight: 800;color: var(--blue-900);letter-spacing: -0.01em}\n.section-head p {font-size: 15px;color: var(--text-muted);margin-top: 6px}\n\n/* 阶梯式递进排列套餐 */\n.stepped-plans {display: flex;flex-direction: column;gap: 20px}\n.plan-step {background: var(--surface);border-radius: var(--radius-lg);padding: 32px 36px;box-shadow: var(--shadow-soft);position: relative;display: grid;grid-template-columns: 200px 180px 1fr 160px;align-items: center;gap: 24px;transition: transform 0.2s ease, box-shadow 0.2s ease}\n.plan-step:hover {box-shadow: var(--shadow-hover)}\n.plan-step-1 {margin-left: 0;border-top: 3px solid var(--blue-700)}\n.plan-step-2 {margin-left: 36px;background: linear-gradient(135deg, #ffffff 0%, var(--amber-50) 100%);border: 2px solid var(--amber-400)}\n.plan-step-3 {margin-left: 72px;background: var(--blue-900);color: #ffffff}\n\n.plan-step-badge {position: absolute;top: -12px;left: 36px;background: var(--amber-500);color: #ffffff;font-size: 12px;font-weight: 700;padding: 3px 12px;border-radius: var(--radius-pill)}\n.plan-tier-title {font-size: 22px;font-weight: 800;letter-spacing: -0.01em}\n.plan-tier-subtitle {font-size: 13px;margin-top: 4px;color: var(--text-muted)}\n.plan-step-3 .plan-tier-subtitle {color: var(--blue-100)}\n\n.plan-price-block .price-main {font-size: 28px;font-weight: 800;line-height: 1}\n.plan-price-block .price-cycle {font-size: 14px;font-weight: 500}\n.plan-price-block .price-sub {font-size: 12px;margin-top: 6px;color: var(--text-muted)}\n.plan-step-3 .plan-price-block .price-sub {color: var(--blue-100)}\n\n.plan-features-list {list-style: none;font-size: 14px;line-height: 1.8}\n.plan-features-list li {position: relative;padding-left: 18px}\n.plan-features-list li::before {content: \"\";position: absolute;left: 0;top: 9px;width: 6px;height: 6px;border-radius: 50%;background: var(--amber-500)}\n.plan-step-3 .plan-features-list li::before {background: var(--amber-300)}\n\n.plan-action {text-align: right}\n.plan-btn {display: inline-block;padding: 12px 24px;border-radius: var(--radius-pill);font-size: 14px;font-weight: 700;text-align: center;transition: all 0.2s ease;white-space: nowrap}\n.btn-primary {background: var(--amber-500);color: #ffffff}\n.btn-primary:hover {background: var(--amber-400)}\n.btn-secondary {background: var(--blue-100);color: var(--blue-900)}\n.btn-secondary:hover {background: var(--blue-700);color: #ffffff}\n.btn-contrast {background: #ffffff;color: var(--blue-900)}\n.btn-contrast:hover {background: var(--amber-300);color: var(--blue-950)}\n\n/* 客户端连接指引 */\n.clients-grid {display: grid;grid-template-columns: repeat(3, 1fr);gap: 20px}\n.client-card {background: var(--surface);border-radius: var(--radius-lg);padding: 30px;box-shadow: var(--shadow-soft)}\n.client-os {font-size: 18px;font-weight: 700;color: var(--blue-900);margin-bottom: 8px}\n.client-desc {font-size: 14px;color: var(--text-muted);margin-bottom: 20px;line-height: 1.6}\n.client-status {display: inline-block;font-size: 12px;font-weight: 600;color: var(--blue-700);background: var(--blue-50);padding: 4px 10px;border-radius: var(--radius-pill)}\n\n/* 使用指引四步 */\n.steps-wrapper {background: var(--surface);border-radius: var(--radius-lg);padding: 36px 40px;box-shadow: var(--shadow-soft)}\n.steps-row {display: grid;grid-template-columns: repeat(4, 1fr);gap: 24px}\n.step-item h3 {font-size: 16px;font-weight: 700;color: var(--blue-900);margin-bottom: 6px}\n.step-num {font-size: 13px;font-weight: 800;color: var(--amber-500);margin-bottom: 8px}\n.step-item p {font-size: 13px;color: var(--text-muted);line-height: 1.6}\n\n/* FAQ 主题分组 */\n.faq-topics {display: grid;grid-template-columns: repeat(2, 1fr);gap: 24px}\n.faq-group {background: var(--surface);border-radius: var(--radius-lg);padding: 32px;box-shadow: var(--shadow-soft)}\n.faq-group-title {font-size: 18px;font-weight: 700;color: var(--blue-900);margin-bottom: 20px;padding-bottom: 12px;border-bottom: 2px solid var(--amber-100)}\n.faq-pair {margin-bottom: 20px}\n.faq-pair:last-child {margin-bottom: 0}\n.faq-q {font-size: 15px;font-weight: 700;color: var(--blue-900);margin-bottom: 6px}\n.faq-a {font-size: 14px;color: var(--text-muted);line-height: 1.6}\n\n/* 页脚 */\n.site-footer {margin-top: 64px;padding-top: 24px;border-top: 1px solid var(--blue-100);text-align: center;font-size: 13px;color: var(--text-muted)}\n\n/* 响应式适配 */\n@media (max-width: 900px) {.plan-step {\n    grid-template-columns: 1fr;gap: 16px;margin-left: 0 !important;}\n  .plan-action {\n    text-align: left;}\n  .clients-grid {\n    grid-template-columns: 1fr;}\n  .steps-row {\n    grid-template-columns: 1fr 1fr;}\n  .faq-topics {\n    grid-template-columns: 1fr;}}\n@media (max-width: 600px) {\n  .hero-editorial {padding: 32px 24px}\n  .hero-editorial h1 {font-size: 26px}\n  .hero-editorial .lede {font-size: 16px}\n  .steps-row {grid-template-columns: 1fr}\n}\n</style><main class=\"site-shell\">\n\n  \n  <article class=\"hero-editorial\">\n    <div class=\"editorial-meta\">\n      <span class=\"tag\">专栏观察</span>\n      <span>架构手记第 14 期</span>\n      <span>阅读时间 3 分钟</span>\n    </div>\n    <h1>RexCloud：重整冗余通道，还原网络应有的直接与秩序</h1>\n    <p class=\"lede\">\n      网络不应被冗长的配置和堆砌的修辞所裹挟。链路的价值在于通达，而非制造混乱。\n    </p>\n    <div class=\"body-column\">\n      <p>\n        在过去数年里，各类协议与工具层出不穷。使用者往往耗费整晚甄别端口、调整本地分流规则，最后却停滞在频发的握手超时中。繁杂的参数遮蔽了最纯粹的诉求——点对点的可靠交付。\n      </p>\n      <p>\n        RexCloud 选择在此处收拢线条。去掉浮躁的口号。不设立模糊的无限承诺。将带宽余量、并发数与路由逻辑全部摆上台面。你看到的是明确的指标，得到的是静默工作的管道。\n      </p>\n      <p>\n        无论处理单点远程工作流，或是分发多端协同任务，结构越收敛，故障点越少。这是我们搭建 RexCloud 的起点，也是本篇记录想说明的全部事实。\n      </p>\n    </div>\n    <div class=\"hero-anchors\">\n      <span class=\"anchor-label\">跳转阅读：</span>\n      <a href=\"#plans\">订阅阶梯</a>\n      <a href=\"#workflow\">部署工序</a>\n      <a href=\"#clients\">平台适配</a>\n      <a href=\"#faq\">答疑汇编</a>\n    </div>\n  </article>\n\n  \n  <section class=\"section-block\" id=\"plans\">\n    <div class=\"section-head\">\n      <span class=\"eyebrow\">Tier Progression</span>\n      <h2>清晰阶梯，按需递进</h2>\n      <p>拒绝复杂附加项。阶梯宽度与承载能力依序延展。</p>\n    </div>\n    <div class=\"stepped-plans\">\n      \n      \n      <div class=\"plan-step plan-step-1\">\n        <div>\n          <div class=\"plan-tier-title\">基础版</div>\n          <div class=\"plan-tier-subtitle\">单人轻量任务基线</div>\n        </div>\n        <div class=\"plan-price-block\">\n          <div class=\"price-main\">¥15<span class=\"price-cycle\">/月</span></div>\n          <div class=\"price-sub\">按年付仅需 ¥150/年</div>\n        </div>\n        <ul class=\"plan-features-list\">\n          <li>每月 100GB 基础数据配额</li>\n          <li>支持 3 台设备并发在线</li>\n          <li>基础流媒体内容访问支持</li>\n          <li>接入普通线路节点池</li>\n        </ul>\n        <div class=\"plan-action\">\n          <a href=\"#\" class=\"plan-btn btn-secondary\">获取接入配置</a>\n        </div>\n      </div>\n\n      \n      <div class=\"plan-step plan-step-2\">\n        <span class=\"plan-step-badge\">推荐首选</span>\n        <div>\n          <div class=\"plan-tier-title\">旗舰版</div>\n          <div class=\"plan-tier-subtitle\">全天候高频吞吐优选</div>\n        </div>\n        <div class=\"plan-price-block\">\n          <div class=\"price-main\">¥35<span class=\"price-cycle\">/月</span></div>\n          <div class=\"price-sub\">按年付仅需 ¥350/年</div>\n        </div>\n        <ul class=\"plan-features-list\">\n          <li>每月 300GB 充足数据流量</li>\n          <li>支持 5 台设备并发在线</li>\n          <li>全节点原生流媒体支持</li>\n          <li>IPLC 专线优化保障低延迟</li>\n          <li>7x24 优先工单响应服务</li>\n        </ul>\n        <div class=\"plan-action\">\n          <a href=\"#\" class=\"plan-btn btn-primary\">立即开始使用</a>\n        </div>\n      </div>\n\n      \n      <div class=\"plan-step plan-step-3\">\n        <div>\n          <div class=\"plan-tier-title\">团队版</div>\n          <div class=\"plan-tier-subtitle\">多成员协作与密集传输</div>\n        </div>\n        <div class=\"plan-price-block\">\n          <div class=\"price-main\">¥85<span class=\"price-cycle\">/月</span></div>\n          <div class=\"price-sub\">按年付仅需 ¥850/年</div>\n        </div>\n        <ul class=\"plan-features-list\">\n          <li>每月 1000GB 大容量数据池</li>\n          <li>支持 20 台设备并发协同</li>\n          <li>VIP 专属高带宽节点资源</li>\n          <li>支持企业级定制路由策略</li>\n          <li>专属客户经理直联对接</li>\n        </ul>\n        <div class=\"plan-action\">\n          <a href=\"#\" class=\"plan-btn btn-contrast\">联系配置团队</a>\n        </div>\n      </div>\n\n    </div>\n  </section>\n\n  \n  <section class=\"section-block\" id=\"workflow\">\n    <div class=\"section-head\">\n      <span class=\"eyebrow\">Implementation</span>\n      <h2>四步完成接入</h2>\n      <p>精简操作链条。几分钟内即可建立稳定连接。</p>\n    </div>\n    <div class=\"steps-wrapper\">\n      <div class=\"steps-row\">\n        <div class=\"step-item\">\n          <div class=\"step-num\">STEP 01</div>\n          <h3>选择层级</h3>\n          <p>评估团队或个人月度配额需求，挑选匹配的阶梯计划。</p>\n        </div>\n        <div class=\"step-item\">\n          <div class=\"step-num\">STEP 02</div>\n          <h3>导入凭据</h3>\n          <p>在用户中心复制通用订阅地址，无缝同步至本地核心。</p>\n        </div>\n        <div class=\"step-item\">\n          <div class=\"step-num\">STEP 03</div>\n          <h3>规则分流</h3>\n          <p>选择推荐的规则集。国内直连，远程通道走定向规则。</p>\n        </div>\n        <div class=\"step-item\">\n          <div class=\"step-num\">STEP 04</div>\n          <h3>开启运行</h3>\n          <p>启动系统代理开关。实时观测链路延迟与流量吞吐。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"section-block\" id=\"clients\">\n    <div class=\"section-head\">\n      <span class=\"eyebrow\">Client Support</span>\n      <h2>平台与通用协议适配</h2>\n      <p>RexCloud 兼容业界主流开源及通用客户端，按环境自由取用。</p>\n    </div>\n    <div class=\"clients-grid\">\n      <div class=\"client-card\">\n        <div class=\"client-os\">macOS &amp; iOS</div>\n        <p class=\"client-desc\">支持通用订阅分发。适配主流基于规则的图形化客户端，系统级自动配置代理。</p>\n        <span class=\"client-status\">提供标准订阅链接</span>\n      </div>\n      <div class=\"client-card\">\n        <div class=\"client-os\">Windows</div>\n        <p class=\"client-desc\">兼容开源内核控制器与轻量代理客户端。一键同步多节点列表与延迟检测。</p>\n        <span class=\"client-status\">提供标准订阅链接</span>\n      </div>\n      <div class=\"client-card\">\n        <div class=\"client-os\">Android &amp; Linux</div>\n        <p class=\"client-desc\">开放标准协议接口，无缝接入移动端开源内核与无头服务器守护进程。</p>\n        <span class=\"client-status\">提供标准订阅链接</span>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"section-block\" id=\"faq\">\n    <div class=\"section-head\">\n      <span class=\"eyebrow\">Inquiry Group</span>\n      <h2>常见问题与说明</h2>\n      <p>针对接入、计费与网络特性的细分答疑。</p>\n    </div>\n    <div class=\"faq-topics\">\n\n      <div class=\"faq-group\">\n        <h3 class=\"faq-group-title\">订阅与计费相关</h3>\n        <div class=\"faq-pair\">\n          <div class=\"faq-q\">套餐流量用尽后会如何处理？</div>\n          <div class=\"faq-a\">流量将在结算日自动重置。若当月提前耗尽，可随时在控制台升阶或选购临时补充包。</div>\n        </div>\n        <div class=\"faq-pair\">\n          <div class=\"faq-q\">是否支持中途变更订阅方案？</div>\n          <div class=\"faq-a\">支持。系统会按当期剩余天数自动计算折抵金额，无需手动退订旧方案。</div>\n        </div>\n        <div class=\"faq-pair\">\n          <div class=\"faq-q\">年付方案是如何结算的？</div>\n          <div class=\"faq-a\">年付方案直接享受整年优惠总价，按年一次性支付，服务期为 365 天。</div>\n        </div>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3 class=\"faq-group-title\">设备与连接配置</h3>\n        <div class=\"faq-pair\">\n          <div class=\"faq-q\">同时在线设备数是如何判定的？</div>\n          <div class=\"faq-a\">指同一时间内正在发送或接收数据的物理设备连接数。切换设备不产生额外限制。</div>\n        </div>\n        <div class=\"faq-pair\">\n          <div class=\"faq-q\">旗舰版所指的 IPLC 专线优势是什么？</div>\n          <div class=\"faq-a\">专线采用点对点直连路径，避开公网拥堵高峰，抖动更小，尤其适合延迟敏感类场景。</div>\n        </div>\n        <div class=\"faq-pair\">\n          <div class=\"faq-q\">遇到配置导入失败时如何排查？</div>\n          <div class=\"faq-a\">请确认本地系统时间已同步至标准网络时间，并检查客户端内核版本是否支持最新订阅字段。</div>\n        </div>\n      </div>\n\n    </div>\n  </section>\n\n  <footer class=\"site-footer\">\n    <p>© RexCloud. 架构精简，通道自治。</p>\n  </footer>\n\n</main>",
